import { useEffect, useState } from 'react';
import axios from 'axios';

// Vite exposes env vars via import.meta.env, and only vars prefixed
// with VITE_ are exposed to client code (see hashmap/.env).
const API_BASE = import.meta.env.VITE_API_BASE_URL || 'http://localhost:5000/api';

interface Progress {
  userId: string;
  currentStep: number;
  completedSteps: number[];
}

interface HashmapTutorialProps {
  userId: string;
}

export default function HashmapTutorial({ userId }: HashmapTutorialProps) {
  const [progress, setProgress] = useState<Progress | null>(null);
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState<string | null>(null);

  useEffect(() => {
    let cancelled = false;

    async function fetchProgress() {
      try {
        setLoading(true);
        const res = await axios.get<Progress>(`${API_BASE}/progress/${userId}`);
        if (!cancelled) setProgress(res.data);
      } catch (err) {
        if (!cancelled) setError('Failed to load progress');
        console.error(err);
      } finally {
        if (!cancelled) setLoading(false);
      }
    }

    fetchProgress();
    return () => {
      cancelled = true;
    };
  }, [userId]);

  async function markStepComplete(step: number) {
    if (!progress) return;
    const completedSteps = progress.completedSteps.includes(step)
      ? progress.completedSteps
      : [...progress.completedSteps, step];

    try {
      const res = await axios.post<Progress>(`${API_BASE}/progress`, {
        userId,
        currentStep: step,
        completedSteps
      });
      setProgress(res.data);
    } catch (err) {
      setError('Failed to save progress');
      console.error(err);
    }
  }

  if (loading) return <p>Loading progress...</p>;
  if (error) return <p style={{ color: 'red' }}>{error}</p>;
  if (!progress) return null;

  return (
    <div>
      <h2>Hashmap Tutorial</h2>
      <p>Current step: {progress.currentStep}</p>
      <p>Completed steps: {progress.completedSteps.join(', ') || 'none yet'}</p>
      <button onClick={() => markStepComplete(progress.currentStep + 1)}>
        Mark next step complete
      </button>
    </div>
  );
}
